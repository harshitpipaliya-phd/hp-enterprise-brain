# Frontend environment variables.

# Bare origin of the Laravel backend. The /api/v1 prefix is added by
# src/api/client.ts, so do NOT include it here.
VITE_API_URL=http://localhost:8000

# Optional overrides — sensible defaults are compiled in, set these only if
# your backend differs.
#
# Tenant carried by the dev-bypass bearer token. Must match the tenantId that
# AuthenticateJwt assigns to 'dev-bypass', because EnsureTenantScope rejects any
# request whose {tenantId} URL segment differs from the token's tenant.
# VITE_AUTH_TENANT_ID=demo-tenant
#
# Organization (sub_institute_id) pre-selected before the user picks one.
# VITE_DEFAULT_ORG_ID=6
